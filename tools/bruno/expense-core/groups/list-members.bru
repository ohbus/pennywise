meta {
  name: List Group Members
  type: http
  seq: 6
}

get {
  url: {{baseUrlExpenseCore}}/expense-core/v1/groups/{{groupId}}/members
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("group members are listed", function() {
    expect(res.getStatus()).to.eql(200);
    expect(res.getBody()).to.be.an("array");
  });
}

script:post-response {
  if (res.status === 200 && res.body.length > 0) {
    bru.setVar("participantId1", res.body[0].membershipId);
  }
}
