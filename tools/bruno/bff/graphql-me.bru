meta {
  name: GraphQL Me
  type: http
  seq: 1
}

post {
  url: {{baseUrlBff}}/graphql
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "query": "query Me { me { accountId displayName timezone defaultCurrency } }",
    "operationName": "Me"
  }
}
