meta {
  name: List Export Requests
  type: http
  seq: 5
}

get {
  url: {{baseUrlAccounts}}/accounts/v1/me/export-requests
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

tests {
  test("export requests are listed", function() {
    expect(res.getStatus()).to.eql(200);
    expect(res.getBody()).to.be.an("array");
  });
}
