meta {
  name: Create Expense
  type: http
  seq: 1
}

post {
  url: {{baseUrlExpenseCore}}/expense-core/v1/groups/{{groupId}}/expenses
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Idempotency-Key: bruno-{{$randomUUID}}
}

body:json {
  {
    "expenseId": "{{$randomUUID}}",
    "description": "Groceries from Billa",
    "category": "food",
    "amount": {
      "currency": "EUR",
      "minor": "4200"
    },
    "payers": [
      {
        "participantId": "00000000-0000-0000-0000-000000000001",
        "amount": {
          "currency": "EUR",
          "minor": "4200"
        }
      }
    ],
    "allocation": {
      "mode": "EQUAL",
      "items": [
        {
          "participantId": "00000000-0000-0000-0000-000000000001",
          "value": "1"
        },
        {
          "participantId": "00000000-0000-0000-0000-000000000002",
          "value": "1"
        }
      ]
    }
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("expenseId", res.body.expenseId);
  }
}

tests {
  test("expense is created", function() {
    expect(res.getStatus()).to.eql(201);
    expect(res.getBody().expenseId).to.be.ok;
    expect(res.getBody().version).to.eql(1);
  });

  test("expense amount is contract-shaped", function() {
    const amount = res.getBody().amount;
    expect(amount.currency).to.eql("EUR");
    expect(amount.minor).to.eql("4200");
  });
}
