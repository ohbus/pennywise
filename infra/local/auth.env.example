# Generate a unique value per environment; never commit the populated file.
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
SQUAREWISE_SECURITY_CREDENTIAL_DIGEST_SECRET=
# Separate 32-byte AES-GCM key for protected auth-email delivery envelopes.
SQUAREWISE_SECURITY_AUTH_EMAIL_ENVELOPE_KEY=
