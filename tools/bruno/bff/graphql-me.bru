meta {
  name: GraphQL Me
  type: http
  seq: 1
}

post {
  url: {{baseUrlBff}}/graphql
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "query": "query Me { me { accountId displayName timezone defaultCurrency } }",
    "operationName": "Me"
  }
}

tests {
  test("GraphQL response has no errors", function() {
    expect(res.getStatus()).to.eql(200);
    expect(res.getBody().errors).to.not.be.ok;
    expect(res.getBody().data.me.accountId).to.be.ok;
  });
}
