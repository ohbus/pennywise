meta {
  name: Search Expenses
  type: http
  seq: 5
}

get {
  url: {{baseUrlExpenseCore}}/expense-core/v1/groups/{{groupId}}/search
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("expense search returns a page", function() {
    expect(res.getStatus()).to.eql(200);
    expect(res.getBody().expenses).to.be.an("array");
  });
}

query {
  query: groceries
  currency: EUR
  category: food
  limit: 50
}
