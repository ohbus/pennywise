meta {
  name: List Groups
  type: http
  seq: 2
}

get {
  url: {{baseUrlExpenseCore}}/expense-core/v1/groups
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("group list is persisted and readable", function() {
    expect(res.getStatus()).to.eql(200);
    expect(res.getBody()).to.be.an("array");
    expect(res.getBody().some(function(group) { return group.groupId === bru.getVar("groupId"); })).to.eql(true);
  });
}
