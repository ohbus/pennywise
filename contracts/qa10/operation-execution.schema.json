{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://squarewise.example/schemas/qa10-operation-execution-v1.json",
  "title": "QA-10 operation execution evidence",
  "type": "object",
  "required": ["schema", "source_revision", "environment", "operations"],
  "properties": {
    "schema": {
      "const": "qa10-operation-execution-v1"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["surface", "operation", "status", "artifact", "assertions"],
        "properties": {
          "surface": {
            "enum": ["REST", "GraphQL Query", "GraphQL Mutation", "GraphQL Subscription"]
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["passed", "failed", "blocked"]
          },
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
