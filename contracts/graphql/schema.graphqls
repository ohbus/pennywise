scalar MoneyMinor
scalar DateTime

type Query { me: Profile!, groups: [Group!]!, group(id: ID!): Group, settlementSuggestions(groupId: ID!): [SuggestedSettlement!]! }
type Mutation { createGroup(input: CreateGroupInput!): Group!, updateGroup(groupId: ID!, name: String!): Group!, createExpense(groupId: ID!, input: CreateExpenseInput!, idempotencyKey: String!): Expense!, recordRepayment(input: RepaymentInput!): Settlement! }
type Subscription { groupChanged(groupId: ID!): GroupInvalidation! }
type Profile { accountId: ID!, displayName: String!, timezone: String!, defaultCurrency: String! }
type Group { id: ID!, name: String!, kind: GroupKind!, revision: Int!, balances: [Balance!]!, expenses: [Expense!]!, members: [Member!]! }
type Member { membershipId: ID!, subject: String }
type Balance { participantId: ID!, money: Money! }
type Money { currency: String!, minor: MoneyMinor! }
type Expense { id: ID!, version: Int!, description: String!, amount: Money!, allocations: [Allocation!]! }
type Allocation { participantId: ID!, amount: Money! }
type Settlement { id: ID!, status: String!, amount: Money! }
type SuggestedSettlement { fromParticipantId: ID!, toParticipantId: ID!, amount: Money! }
type GroupInvalidation { groupId: ID!, revision: Int!, changeId: ID! }
enum GroupKind { HOUSEHOLD COUPLE TRIP }
input CreateGroupInput { name: String!, kind: GroupKind!, currency: String! }
input CreateExpenseInput { expenseId: ID!, description: String!, amount: MoneyInput!, payers: [PayerInput!]!, allocation: AllocationInput! }
input MoneyInput { currency: String!, minor: MoneyMinor! }
input PayerInput { participantId: ID!, amount: MoneyInput! }
input AllocationInput { mode: String!, items: [AllocationItemInput!]! }
input AllocationItemInput { participantId: ID!, value: String! }
input RepaymentInput { groupId: ID, fromParticipantId: ID!, toParticipantId: ID!, amount: MoneyInput!, reason: String }
