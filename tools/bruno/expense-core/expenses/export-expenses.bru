meta {
  name: Export Expenses CSV
  type: http
  seq: 6
}

get {
  url: {{baseUrlExpenseCore}}/expense-core/v1/groups/{{groupId}}/export
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Accept: text/csv
}

tests {
  test("expense export returns CSV", function() {
    expect(res.getStatus()).to.eql(200);
    expect(res.getHeader("Content-Type")).to.match(/^text\/csv/);
  });
}

query {
  currency: EUR
  maxRows: 1000
}
