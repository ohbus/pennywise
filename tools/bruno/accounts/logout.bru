meta {
  name: Logout
  type: http
  seq: 11
}

post {
  url: {{baseUrlAccounts}}/accounts/v1/auth/logout
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "refreshToken": "00000000-0000-0000-0000-000000000001"
  }
}

tests {
  test("logout revokes session or unauthorized", function() {
    expect([204, 401]).to.include(res.getStatus());
  });
}
