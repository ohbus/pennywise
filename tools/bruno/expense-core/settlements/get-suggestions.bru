meta {
  name: Get Settlement Suggestions
  type: http
  seq: 2
}

get {
  url: {{baseUrlExpenseCore}}/expense-core/v1/groups/{{groupId}}/settlements/suggestions
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("settlement suggestions are returned", function() {
    expect(res.getStatus()).to.eql(200);
    expect(res.getBody()).to.be.an("array");
  });
}
