meta {
  name: Record Settlement
  type: http
  seq: 1
}

post {
  url: {{baseUrlExpenseCore}}/expense-core/v1/groups/{{groupId}}/settlements
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

tests {
  test("settlement is recorded", function() {
    expect(res.getStatus()).to.eql(201);
    expect(res.getBody().id).to.be.ok;
  });
}

body:json {
  {
    "fromParticipantId": "00000000-0000-0000-0000-000000000002",
    "toParticipantId": "00000000-0000-0000-0000-000000000001",
    "amountMinor": "2100"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("settlementId", res.body.id);
  }
}
