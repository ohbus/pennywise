meta {
  name: Get Group
  type: http
  seq: 3
}

get {
  url: {{baseUrlExpenseCore}}/expense-core/v1/groups/{{groupId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("group is readable", function() {
    expect(res.getStatus()).to.eql(200);
    expect(res.getBody().groupId).to.eql(bru.getVar("groupId"));
  });
}
