meta {
  name: Add Named Placeholder
  type: http
  seq: 7
}

post {
  url: {{baseUrlExpenseCore}}/expense-core/v1/groups/{{groupId}}/placeholders
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

tests {
  test("placeholder is created", function() {
    expect(res.getStatus()).to.eql(201);
    expect(res.getBody().membershipId).to.be.ok;
  });
}

body:json {
  {
    "name": "Bob (offline member)"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("membershipId", res.body.membershipId);
  }
}
