meta {
  name: Invalid bearer is rejected by Notifications
  type: http
  seq: 5
}

get {
  url: {{baseUrlNotifications}}/notifications/v1/preferences
  body: none
  auth: none
}

headers {
  Authorization: Bearer not-a-signed-jwt
}

tests {
  test("malformed bearer is rejected", function() {
    expect(res.getStatus()).to.eql(401);
  });
}
