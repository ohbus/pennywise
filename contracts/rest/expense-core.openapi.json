{
  "openapi": "3.1.1",
  "info": {"title": "Expense Core API", "version": "1.0.0"},
  "servers": [{"url": "/expense-core/v1"}],
  "paths": {
    "/groups": {"post": {"operationId": "createGroup", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateGroup"}}}}, "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Group"}}}}}}, "get": {"operationId": "listGroups", "responses": {"200": {"description": "Groups"}}}},
    "/groups/{groupId}": {"x-implementation-status": "implemented-durable", "parameters": [{"$ref": "#/components/parameters/GroupId"}], "get": {"operationId": "getGroup", "responses": {"200": {"description": "Group details", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Group"}}}}}}, "patch": {"operationId": "updateGroup", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UpdateGroup"}}}}, "responses": {"200": {"description": "Updated group", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Group"}}}}, "404": {"description": "Group not found or not a member"}}}},
    "/allocations/preview": {"x-implementation-status": "implemented-durable", "post": {"operationId": "previewAllocation", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AllocationPreviewRequest"}}}}, "responses": {"200": {"description": "Equal allocation preview", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AllocationPreviewResponse"}}}}, "400": {"description": "Invalid allocation preview request"}}}},
    "/groups/{groupId}/archive": {"x-implementation-status": "implemented-durable", "parameters": [{"$ref": "#/components/parameters/GroupId"}], "post": {"operationId": "archiveGroup", "responses": {"200": {"description": "Group archived", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Group"}}}}, "404": {"description": "Group not found or not a member"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/groups/{groupId}/members": {"x-implementation-status": "implemented-durable", "parameters": [{"$ref": "#/components/parameters/GroupId"}], "get": {"operationId": "listGroupMembers", "responses": {"200": {"description": "Group members", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/GroupMember"}}}}}}}},
    "/groups/{groupId}/placeholders": {"x-implementation-status": "implemented-durable", "parameters": [{"$ref": "#/components/parameters/GroupId"}], "post": {"operationId": "createPlaceholder", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreatePlaceholder"}}}}, "responses": {"201": {"description": "Placeholder created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GroupMember"}}}}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/groups/{groupId}/members/{membershipId}": {"x-implementation-status": "implemented-durable", "parameters": [{"$ref": "#/components/parameters/GroupId"}, {"name": "membershipId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}], "delete": {"operationId": "removeGroupMember", "responses": {"204": {"description": "Member removed"}, "404": {"description": "Group or member not found"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/groups/{groupId}/invites": {"parameters": [{"$ref": "#/components/parameters/GroupId"}], "post": {"operationId": "createInvite", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateInvite"}}}}, "responses": {"201": {"description": "Invite created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Invite"}}}}}}},
    "/groups/{groupId}/invites/{token}/revoke": {"x-implementation-status": "implemented-durable", "parameters": [{"$ref": "#/components/parameters/GroupId"}, {"$ref": "#/components/parameters/InviteToken"}], "post": {"operationId": "revokeInvite", "responses": {"204": {"description": "Invite revoked"}, "404": {"description": "Group or invite not found"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/invites/{token}/claim": {"parameters": [{"$ref": "#/components/parameters/InviteToken"}], "post": {"operationId": "claimInvite", "responses": {"200": {"description": "Invite claimed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Group"}}}}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/groups/{groupId}/expenses": {"x-implementation-status": "implemented-durable", "parameters": [{"$ref": "#/components/parameters/GroupId"}], "post": {"operationId": "createExpense", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateExpense"}}}}, "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Expense"}}}}, "409": {"$ref": "#/components/responses/Conflict"}}}, "get": {"operationId": "listExpenses", "parameters": [{"$ref": "#/components/parameters/Cursor"}, {"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/Category"}], "responses": {"200": {"description": "Bounded expense page"}, "400": {"$ref": "#/components/responses/Problem"}}}},
    "/groups/{groupId}/expenses/{expenseId}": {"x-implementation-status": "implemented-durable", "parameters": [{"$ref": "#/components/parameters/GroupId"}, {"name": "expenseId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}], "put": {"operationId": "updateExpense", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UpdateExpense"}}}}, "responses": {"200": {"description": "Updated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Expense"}}}}, "409": {"$ref": "#/components/responses/Conflict"}}}, "delete": {"operationId": "deleteExpense", "responses": {"204": {"description": "Deleted"}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/groups/{groupId}/settlements": {"x-implementation-status": "implemented-durable", "parameters": [{"$ref": "#/components/parameters/GroupId"}], "post": {"operationId": "recordSettlement", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RecordSettlement"}}}}, "responses": {"201": {"description": "Settlement recorded", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Settlement"}}}}}}},
    "/groups/{groupId}/settlements/suggestions": {"x-implementation-status": "implemented-durable", "parameters": [{"$ref": "#/components/parameters/GroupId"}], "get": {"operationId": "getSettlementSuggestions", "responses": {"200": {"description": "Suggested settlement payments", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/SuggestedSettlement"}}}}}}}},
    "/groups/{groupId}/settlements/{settlementId}/reversal": {"x-implementation-status": "implemented-durable", "parameters": [{"$ref": "#/components/parameters/GroupId"}, {"$ref": "#/components/parameters/SettlementId"}], "post": {"operationId": "reverseSettlement", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReverseSettlement"}}}}, "responses": {"200": {"description": "Settlement reversed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Settlement"}}}}, "404": {"description": "Settlement not found", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}, "409": {"$ref": "#/components/responses/Conflict"}}}},
    "/groups/{groupId}/balances": {"x-implementation-status": "implemented-durable", "get": {"operationId": "getBalances", "parameters": [{"$ref": "#/components/parameters/GroupId"}], "responses": {"200": {"description": "Currency-separated balances"}}}},
    "/groups/{groupId}/sync/snapshot": {"x-implementation-status": "implemented-durable", "get": {"operationId": "getSnapshot", "parameters": [{"$ref": "#/components/parameters/GroupId"}], "responses": {"200": {"description": "Materialized snapshot and cursor"}}}},
    "/groups/{groupId}/sync/changes": {"x-implementation-status": "implemented-durable", "get": {"operationId": "getChanges", "parameters": [{"$ref": "#/components/parameters/GroupId"}], "responses": {"200": {"description": "Changes and tombstones"}}}},
    "/groups/{groupId}/search": {"x-implementation-status": "implemented-durable", "parameters": [{"$ref": "#/components/parameters/GroupId"}], "get": {"operationId": "searchExpenses", "parameters": [{"name": "query", "in": "query", "required": false, "schema": {"type": "string"}}, {"name": "currency", "in": "query", "required": false, "schema": {"type": "string", "pattern": "^[A-Z]{3}$"}}, {"$ref": "#/components/parameters/Category"}, {"$ref": "#/components/parameters/Cursor"}, {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 100}}], "responses": {"200": {"description": "Search results page with currency totals", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExpenseSearchPage"}}}}, "404": {"description": "Group not found or unauthorized"}}}},
    "/groups/{groupId}/export": {"x-implementation-status": "implemented-durable", "parameters": [{"$ref": "#/components/parameters/GroupId"}], "get": {"operationId": "exportExpenses", "parameters": [{"name": "query", "in": "query", "required": false, "schema": {"type": "string"}}, {"name": "currency", "in": "query", "required": false, "schema": {"type": "string", "pattern": "^[A-Z]{3}$"}}, {"$ref": "#/components/parameters/Category"}, {"name": "maxRows", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 10000, "default": 10000}}], "responses": {"200": {"description": "CSV export of expenses", "content": {"text/csv": {"schema": {"type": "string"}}}}, "400": {"description": "Invalid query or export limits exceeded"}, "404": {"description": "Group not found or unauthorized"}}}},
    "/groups/{groupId}/schedules": {"x-implementation-status": "implemented-durable", "parameters": [{"$ref": "#/components/parameters/GroupId"}], "post": {"operationId": "createRecurringSchedule", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateRecurringSchedule"}}}}, "responses": {"201": {"description": "Recurring schedule created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RecurringSchedule"}}}}, "404": {"description": "Group not found"}}}, "get": {"operationId": "listRecurringSchedules", "responses": {"200": {"description": "List of recurring schedules", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/RecurringSchedule"}}}}}}}},
    "/groups/{groupId}/schedules/{scheduleId}": {"x-implementation-status": "implemented-durable", "parameters": [{"$ref": "#/components/parameters/GroupId"}, {"$ref": "#/components/parameters/ScheduleId"}], "get": {"operationId": "getRecurringSchedule", "responses": {"200": {"description": "Recurring schedule details", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RecurringSchedule"}}}}, "404": {"description": "Schedule not found"}}}, "put": {"operationId": "updateRecurringSchedule", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UpdateRecurringSchedule"}}}}, "responses": {"200": {"description": "Recurring schedule updated", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RecurringSchedule"}}}}, "404": {"description": "Schedule not found"}}}},
    "/groups/{groupId}/schedules/{scheduleId}/pause": {"x-implementation-status": "implemented-durable", "parameters": [{"$ref": "#/components/parameters/GroupId"}, {"$ref": "#/components/parameters/ScheduleId"}], "post": {"operationId": "pauseRecurringSchedule", "responses": {"200": {"description": "Recurring schedule paused", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RecurringSchedule"}}}}, "404": {"description": "Schedule not found"}}}},
    "/groups/{groupId}/schedules/{scheduleId}/resume": {"x-implementation-status": "implemented-durable", "parameters": [{"$ref": "#/components/parameters/GroupId"}, {"$ref": "#/components/parameters/ScheduleId"}], "post": {"operationId": "resumeRecurringSchedule", "responses": {"200": {"description": "Recurring schedule resumed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RecurringSchedule"}}}}, "404": {"description": "Schedule not found"}}}}
  },
  "components": {"parameters": {"GroupId": {"name": "groupId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}, "ScheduleId": {"name": "scheduleId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}, "SettlementId": {"name": "settlementId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}, "InviteToken": {"name": "token", "in": "path", "required": true, "schema": {"type": "string", "minLength": 64, "maxLength": 64}}, "Cursor": {"name": "cursor", "in": "query", "required": false, "schema": {"type": "string"}}, "Limit": {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}}, "Category": {"name": "category", "in": "query", "required": false, "schema": {"$ref": "#/components/schemas/ExpenseCategory"}}, "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 16, "maxLength": 200}}}, "schemas": {
    "Money": {"type": "object", "required": ["currency", "minor"], "properties": {"currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "minor": {"type": "string", "pattern": "^-?[0-9]+$"}}},
    "CreateGroup": {"type": "object", "required": ["name", "kind", "currency"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 120}, "kind": {"type": "string", "enum": ["HOUSEHOLD", "COUPLE", "TRIP"]}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}},
    "Group": {"type": "object", "required": ["groupId", "name", "revision"], "properties": {"groupId": {"type": "string", "format": "uuid"}, "name": {"type": "string"}, "revision": {"type": "integer", "minimum": 0}}},
    "UpdateGroup": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 120}}},
    "GroupMember": {"type": "object", "required": ["membershipId", "groupId", "subject"], "properties": {"membershipId": {"type": "string", "format": "uuid"}, "groupId": {"type": "string", "format": "uuid"}, "subject": {"type": "string"}}},
    "CreateInvite": {"type": "object", "required": ["expiresInHours"], "properties": {"expiresInHours": {"type": "integer", "minimum": 1, "maximum": 168}}},
    "Invite": {"type": "object", "required": ["token", "expiresAt"], "properties": {"token": {"type": "string"}, "expiresAt": {"type": "string", "format": "date-time"}}},
    "CreateExpense": {"type": "object", "required": ["expenseId", "description", "amount", "payers", "allocation"], "properties": {"expenseId": {"type": "string", "format": "uuid"}, "description": {"type": "string", "minLength": 1, "maxLength": 240}, "category": {"$ref": "#/components/schemas/ExpenseCategory", "default": "other"}, "amount": {"$ref": "#/components/schemas/Money"}, "payers": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["participantId", "amount"], "properties": {"participantId": {"type": "string", "format": "uuid"}, "amount": {"$ref": "#/components/schemas/Money"}}}}, "allocation": {"type": "object", "required": ["mode", "items"], "properties": {"mode": {"type": "string", "enum": ["EQUAL", "EXACT", "PERCENT_BASIS_POINTS", "WEIGHTED_SHARES"]}, "items": {"type": "array", "items": {"type": "object", "required": ["participantId", "value"], "properties": {"participantId": {"type": "string", "format": "uuid"}, "value": {"type": "string", "pattern": "^[0-9]+$"}}}}}}}},
    "UpdateExpense": {"type": "object", "required": ["version", "description", "amount", "payers", "allocation"], "properties": {"version": {"type": "integer", "minimum": 1}, "description": {"type": "string", "minLength": 1, "maxLength": 240}, "category": {"$ref": "#/components/schemas/ExpenseCategory", "default": "other"}, "amount": {"$ref": "#/components/schemas/Money"}, "payers": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["participantId", "amount"], "properties": {"participantId": {"type": "string", "format": "uuid"}, "amount": {"$ref": "#/components/schemas/Money"}}}}, "allocation": {"type": "object", "required": ["mode", "items"], "properties": {"mode": {"type": "string", "enum": ["EQUAL", "EXACT", "PERCENT_BASIS_POINTS", "WEIGHTED_SHARES"]}, "items": {"type": "array", "items": {"type": "object", "required": ["participantId", "value"], "properties": {"participantId": {"type": "string", "format": "uuid"}, "value": {"type": "string", "pattern": "^[0-9]+$"}}}}}}}},
    "ExpenseCategory": {"type": "string", "enum": ["food", "lodging", "transport", "entertainment", "shopping", "bills", "health", "other"]},
    "Expense": {"type": "object", "required": ["expenseId", "version", "amount", "allocations"], "properties": {"expenseId": {"type": "string", "format": "uuid"}, "version": {"type": "integer", "minimum": 1}, "amount": {"$ref": "#/components/schemas/Money"}, "category": {"$ref": "#/components/schemas/ExpenseCategory"}, "allocations": {"type": "array", "items": {"type": "object"}}}},
    "RecordSettlement": {"type": "object", "required": ["fromParticipantId", "toParticipantId", "amountMinor"], "properties": {"fromParticipantId": {"type": "string", "format": "uuid"}, "toParticipantId": {"type": "string", "format": "uuid"}, "amountMinor": {"type": "string", "pattern": "^[0-9]+$"}}},
    "ReverseSettlement": {"type": "object", "required": ["reason"], "properties": {"reason": {"type": "string", "minLength": 1, "maxLength": 240}}},
    "Settlement": {"type": "object", "required": ["id", "fromParticipantId", "toParticipantId", "amountMinor", "status"], "properties": {"id": {"type": "string", "format": "uuid"}, "fromParticipantId": {"type": "string", "format": "uuid"}, "toParticipantId": {"type": "string", "format": "uuid"}, "amountMinor": {"type": "integer", "minimum": 1}, "reason": {"type": ["string", "null"]}, "status": {"type": "string", "enum": ["RECORDED", "REVERSED"]}}},
    "SuggestedSettlement": {"type": "object", "required": ["fromParticipantId", "toParticipantId", "amountMinor", "currency"], "properties": {"fromParticipantId": {"type": "string", "format": "uuid"}, "toParticipantId": {"type": "string", "format": "uuid"}, "amountMinor": {"type": "integer", "minimum": 1}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}}},
    "AllocationPreviewRequest": {"type": "object", "required": ["totalMinor", "participantIds"], "properties": {"totalMinor": {"type": "string", "pattern": "^[0-9]+$"}, "participantIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "AllocationPreviewResponse": {"type": "object", "required": ["totalMinor", "allocations"], "properties": {"totalMinor": {"type": "string", "pattern": "^[0-9]+$"}, "allocations": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9]+$"}}}},
    "SearchExpense": {"type": "object", "required": ["expenseId", "description", "currency", "amountMinor", "category"], "properties": {"expenseId": {"type": "string", "format": "uuid"}, "description": {"type": "string"}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "amountMinor": {"type": "string", "pattern": "^[0-9]+$"}, "category": {"$ref": "#/components/schemas/ExpenseCategory"}}},
    "CurrencyTotal": {"type": "object", "required": ["currency", "amountMinor"], "properties": {"currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "amountMinor": {"type": "string", "pattern": "^[0-9]+$"}}},
    "ExpenseSearchPage": {"type": "object", "required": ["expenses", "hasMore", "totals"], "properties": {"expenses": {"type": "array", "items": {"$ref": "#/components/schemas/SearchExpense"}}, "nextCursor": {"type": "string"}, "hasMore": {"type": "boolean"}, "totals": {"type": "array", "items": {"$ref": "#/components/schemas/CurrencyTotal"}}}},
    "RecurrenceFrequency": {"type": "string", "enum": ["WEEKLY", "MONTHLY"]},
    "CreateRecurringSchedule": {"type": "object", "required": ["description", "amount", "frequency", "startDate"], "properties": {"description": {"type": "string", "minLength": 1, "maxLength": 240}, "amount": {"$ref": "#/components/schemas/Money"}, "frequency": {"$ref": "#/components/schemas/RecurrenceFrequency"}, "dayOfMonth": {"type": "integer", "minimum": 1, "maximum": 31}, "startDate": {"type": "string", "format": "date"}, "endDate": {"type": "string", "format": "date"}}},
    "UpdateRecurringSchedule": {"type": "object", "required": ["description", "amount", "frequency", "startDate"], "properties": {"description": {"type": "string", "minLength": 1, "maxLength": 240}, "amount": {"$ref": "#/components/schemas/Money"}, "frequency": {"$ref": "#/components/schemas/RecurrenceFrequency"}, "dayOfMonth": {"type": "integer", "minimum": 1, "maximum": 31}, "startDate": {"type": "string", "format": "date"}, "endDate": {"type": "string", "format": "date"}}},
    "RecurringSchedule": {"type": "object", "required": ["scheduleId", "groupId", "description", "amount", "frequency", "startDate", "nextOccurrenceDate", "paused", "createdAt", "version"], "properties": {"scheduleId": {"type": "string", "format": "uuid"}, "groupId": {"type": "string", "format": "uuid"}, "description": {"type": "string"}, "amount": {"$ref": "#/components/schemas/Money"}, "frequency": {"$ref": "#/components/schemas/RecurrenceFrequency"}, "dayOfMonth": {"type": "integer"}, "startDate": {"type": "string", "format": "date"}, "endDate": {"type": "string", "format": "date"}, "nextOccurrenceDate": {"type": "string", "format": "date"}, "paused": {"type": "boolean"}, "createdAt": {"type": "string", "format": "date-time"}, "version": {"type": "integer"}}}
  }, "responses": {"Conflict": {"description": "Stale version or idempotency conflict"}}}
}
