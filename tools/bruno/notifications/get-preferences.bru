meta {
  name: Get Notification Preferences
  type: http
  seq: 3
}

get {
  url: {{baseUrlNotifications}}/notifications/v1/preferences
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Accept: application/json
}

tests {
  test("notification preferences are readable", function() {
    expect(res.getStatus()).to.eql(200);
    expect(res.getBody().emailEnabled).to.be.a("boolean");
    expect(res.getBody().pushEnabled).to.be.a("boolean");
  });
}
