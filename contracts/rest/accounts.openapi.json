{
  "openapi": "3.1.1",
  "info": {"title": "Accounts API", "version": "1.0.0"},
  "servers": [{"url": "/accounts/v1"}],
  "paths": {
    "/auth/login/start": {"post": {"operationId": "startLogin", "description": "Starts passwordless login and always returns the same accepted shape for valid, invalid, unknown, or throttled inputs.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginStartRequest"}}}}, "responses": {"202": {"description": "Login request accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginStartResponse"}}}}, "400": {"$ref": "#/components/responses/Problem"}}}},
    "/auth/login/verify": {"post": {"operationId": "verifyLogin", "description": "Redeems a single-use passwordless credential; invalid, expired, replayed, and exhausted credentials are indistinguishable.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginVerifyRequest"}}}}, "responses": {"200": {"description": "Authenticated token response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenResponse"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/auth/token/refresh": {"post": {"operationId": "refreshToken", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RefreshTokenRequest"}}}}, "responses": {"200": {"description": "Rotated token response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenResponse"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/auth/logout": {"post": {"operationId": "logout", "security": [{"bearerAuth": []}], "responses": {"204": {"description": "Session revoked"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/me": {
      "get": {"operationId": "getMe", "responses": {"200": {"description": "Profile", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Profile"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}},
      "patch": {"operationId": "updateMe", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProfilePatch"}}}}, "responses": {"200": {"description": "Updated profile", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Profile"}}}}, "400": {"$ref": "#/components/responses/Problem"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}
    },
    "/me/deletion-request": {"post": {"operationId": "requestDeletion", "responses": {"202": {"description": "Deletion request accepted"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/me/export-request": {"post": {"operationId": "requestExport", "responses": {"202": {"description": "Export request accepted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExportRequest"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/me/export-requests": {"get": {"operationId": "listExportRequests", "responses": {"200": {"description": "List of export requests", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/ExportRequest"}}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/profiles/{accountId}": {"get": {"operationId": "getProfileById", "parameters": [{"name": "accountId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}], "responses": {"200": {"description": "Profile", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Profile"}}}}, "404": {"description": "Profile not found", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}}}},
    "/profiles/batch": {"post": {"operationId": "getProfilesBatch", "description": "Fetches user profiles for a batch of account IDs. Duplicate IDs in the request are deduplicated and non-existent IDs are omitted from the resulting list without failing the request.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BatchProfileRequest"}}}}, "responses": {"200": {"description": "List of profiles matching existing requested account IDs", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Profile"}}}}}, "400": {"$ref": "#/components/responses/Problem"}}}}
  },
  "components": {"schemas": {
    "Profile": {"type": "object", "required": ["accountId", "displayName", "timezone", "defaultCurrency"], "properties": {"accountId": {"type": "string", "format": "uuid"}, "displayName": {"type": "string", "minLength": 1, "maxLength": 120}, "timezone": {"type": "string"}, "defaultCurrency": {"type": "string", "pattern": "^[A-Z]{3}$"}}},
    "ProfilePatch": {"type": "object", "minProperties": 1, "properties": {"displayName": {"type": "string", "minLength": 1, "maxLength": 120}, "timezone": {"type": "string"}, "defaultCurrency": {"type": "string", "pattern": "^[A-Z]{3}$"}}},
    "ExportRequest": {"type": "object", "required": ["exportId", "status", "requestedAt"], "properties": {"exportId": {"type": "string", "format": "uuid"}, "status": {"type": "string", "enum": ["REQUESTED", "READY", "EXPIRED"]}, "requestedAt": {"type": "string", "format": "date-time"}}},
    "BatchProfileRequest": {"type": "object", "required": ["accountIds"], "properties": {"accountIds": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "format": "uuid"}}}},
    "LoginStartRequest": {"type": "object", "required": ["email"], "additionalProperties": false, "properties": {"email": {"type": "string", "format": "email", "maxLength": 254}, "channel": {"type": "string", "enum": ["LINK", "CODE"]}, "clientKind": {"type": "string", "enum": ["BROWSER", "NATIVE"]}}},
    "LoginStartResponse": {"type": "object", "required": ["status"], "additionalProperties": false, "properties": {"status": {"type": "string", "enum": ["ACCEPTED"]}}},
    "LoginVerifyRequest": {"type": "object", "required": ["credential", "clientKind"], "additionalProperties": false, "properties": {"credential": {"type": "string", "minLength": 1, "maxLength": 512}, "clientKind": {"type": "string", "enum": ["BROWSER", "NATIVE"]}}},
    "RefreshTokenRequest": {"type": "object", "required": ["refreshToken"], "additionalProperties": false, "properties": {"refreshToken": {"type": "string", "minLength": 1, "maxLength": 512}}},
    "TokenResponse": {"type": "object", "required": ["accessToken", "tokenType", "expiresIn", "refreshToken"], "additionalProperties": false, "properties": {"accessToken": {"type": "string"}, "tokenType": {"type": "string", "enum": ["Bearer"]}, "expiresIn": {"type": "integer", "minimum": 1}, "refreshToken": {"type": "string"}}},
    "Problem": {"type": "object", "required": ["type", "title", "status", "code", "requestId"], "properties": {"type": {"type": "string", "format": "uri-reference"}, "title": {"type": "string"}, "status": {"type": "integer"}, "code": {"type": "string"}, "requestId": {"type": "string"}, "detail": {"type": "string"}}}
  }, "responses": {"Problem": {"description": "Problem details", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}, "Unauthorized": {"description": "Authentication required"}}}
}
