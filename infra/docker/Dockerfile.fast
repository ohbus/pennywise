# Fast local runtime image using host-built bootJar
FROM eclipse-temurin:25-jre
ARG APP_PROJECT
ENV APP_PROJECT=${APP_PROJECT}
WORKDIR /app
RUN useradd --system --create-home --uid 10001 pennywise
COPY "app/${APP_PROJECT}/build/libs/pennywise-${APP_PROJECT}-0.1.0-SNAPSHOT.jar" /app/app.jar
USER pennywise
EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "/app/app.jar"]
