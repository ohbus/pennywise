meta {
  name: Update My Profile
  type: http
  seq: 2
}

patch {
  url: {{baseUrlAccounts}}/accounts/v1/me
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

tests {
  test("profile update succeeds", function() {
    expect(res.getStatus()).to.eql(200);
    expect(res.getBody().accountId).to.be.ok;
  });
}

body:json {
  {
    "displayName": "Alice Demo",
    "timezone": "Europe/Vienna",
    "defaultCurrency": "EUR"
  }
}
