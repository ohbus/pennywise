meta {
  name: Update Group
  type: http
  seq: 4
}

patch {
  url: {{baseUrlExpenseCore}}/expense-core/v1/groups/{{groupId}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

tests {
  test("group update succeeds", function() {
    expect(res.getStatus()).to.eql(200);
    expect(res.getBody().name).to.be.ok;
  });
}

body:json {
  {
    "name": "Updated Household Name"
  }
}
