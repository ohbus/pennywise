meta {
  name: Reverse Settlement
  type: http
  seq: 3
}

post {
  url: {{baseUrlExpenseCore}}/expense-core/v1/groups/{{groupId}}/settlements/{{settlementId}}/reversal
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

tests {
  test("settlement reversal succeeds", function() {
    expect(res.getStatus()).to.eql(200);
    expect(res.getBody().status).to.eql("REVERSED");
  });
}

body:json {
  {
    "reason": "Incorrect amount recorded"
  }
}
