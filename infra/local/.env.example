# ==============================================================================
# Squarewise Local Development Environment Configuration
# Copy this file to infra/local/.env (or root .env) for clone-and-run local development:
#   cp infra/local/.env.example infra/local/.env
# ==============================================================================

# Cryptographic secrets for local session digest and auth email delivery encryption.
# In local development these safe, deterministic local-only keys allow immediate startup.
SQUAREWISE_SECURITY_CREDENTIAL_DIGEST_SECRET=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
SQUAREWISE_SECURITY_AUTH_EMAIL_ENVELOPE_KEY=ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8=

# Keycloak Identity Provider (Port 8090 on host, 8080 on container network)
KEYCLOAK_HOST_PORT=8090
KEYCLOAK_REALM=squarewise
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=local-admin-only

# Infrastructure hostnames and defaults
SQUAREWISE_POSTGRES_HOSTNAME=postgres-db
POSTGRES_USER=squarewise
POSTGRES_PASSWORD=squarewise-local-only
POSTGRES_DB=squarewise

SQUAREWISE_RABBITMQ_HOSTNAME=message-broker
RABBITMQ_DEFAULT_USER=squarewise
RABBITMQ_DEFAULT_PASS=squarewise-local-only

SQUAREWISE_REDIS_HOSTNAME=rate-limit-redis
REDIS_PASSWORD=squarewise-redis-local-only

SQUAREWISE_MAILPIT_HOSTNAME=mailpit-email
MAILPIT_SMTP_PORT=1025

# Container image tags
POSTGRES_IMAGE=postgres:17
RABBITMQ_IMAGE=rabbitmq:4.3-management
REDIS_IMAGE=redis:8.2-alpine
MAILPIT_IMAGE=axllent/mailpit:v1.27
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.4
