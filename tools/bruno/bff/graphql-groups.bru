meta {
  name: GraphQL Groups
  type: http
  seq: 2
}

post {
  url: {{baseUrlBff}}/graphql
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

tests {
  test("group GraphQL response has no errors", function() {
    expect(res.getStatus()).to.eql(200);
    expect(res.getBody().errors).to.not.be.ok;
    expect(res.getBody().data).to.be.ok;
  });
}

body:json {
  {
    "query": "query Groups { groups { id name kind revision members { membershipId subject } } }",
    "operationName": "Groups"
  }
}
