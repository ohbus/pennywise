{
  "realm": "squarewise",
  "enabled": true,
  "displayName": "Squarewise Local",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "clients": [
    {
      "clientId": "squarewise-api",
      "name": "Squarewise API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "access.token.signed.response.alg": "RS256",
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "squarewise-ci",
      "name": "Squarewise CI service account",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "squarewise-ci-local-only",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "squarewise-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "squarewise-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "squarewise-ci-wrong-audience",
      "name": "Squarewise CI negative-audience fixture",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "squarewise-ci-wrong-audience-local-only",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "squarewise-ci-e2e-bob",
      "name": "Squarewise CI E2E second persona",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "squarewise-ci-e2e-bob-local-only",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "squarewise-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "squarewise-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "squarewise-ci-e2e-nonmember",
