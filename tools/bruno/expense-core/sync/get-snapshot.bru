meta {
  name: Get Sync Snapshot
  type: http
  seq: 2
}

get {
  url: {{baseUrlExpenseCore}}/expense-core/v1/groups/{{groupId}}/sync/snapshot
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("sync snapshot is returned", function() {
    expect(res.getStatus()).to.eql(200);
    expect(res.getBody().changes).to.be.an("array");
  });
}
