meta {
  name: Get Group Balances
  type: http
  seq: 1
}

get {
  url: {{baseUrlExpenseCore}}/expense-core/v1/groups/{{groupId}}/balances
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("group balances are returned", function() {
    expect(res.getStatus()).to.eql(200);
    expect(res.getBody().balances).to.be.an("array");
  });
}
