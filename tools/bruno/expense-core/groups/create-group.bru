meta {
  name: Create Group
  type: http
  seq: 1
}

post {
  url: {{baseUrlExpenseCore}}/expense-core/v1/groups
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Demo Household",
    "kind": "HOUSEHOLD",
    "currency": "EUR"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("groupId", res.body.groupId);
  }
}

tests {
  test("group is created", function() {
    expect(res.getStatus()).to.eql(201);
    expect(res.getBody().groupId).to.be.ok;
  });

  test("group response has domain fields", function() {
    const body = res.getBody();
    expect(body.name).to.be.ok;
    expect(body.status).to.eql("ACTIVE");
    expect(body.revision).to.eql(0);
  });
}
